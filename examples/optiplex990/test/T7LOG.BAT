@ECHO OFF
ECHO T7LOG: -l logging, -q, usage and error paths
IF EXIST OUT\T7LOG.TXT DEL OUT\T7LOG.TXT
W9XFIX -q -l OUT\T7LOG.TXT show
W9XFIX -q -l OUT\T7LOG.TXT aspm
W9XFIX -q -l OUT\T7LOG.TXT ehci
W9XFIX -q -l OUT\T7LOG.TXT check
W9XFIX > OUT\T7USAGE.TXT
W9XFIX badcmd >> OUT\T7USAGE.TXT
IF ERRORLEVEL 2 ECHO T7LOG: usage rc=2 OK >> OUT\T7USAGE.TXT
W9XFIX intx >> OUT\T7USAGE.TXT
W9XFIX intx nonsense off >> OUT\T7USAGE.TXT
W9XFIX ehci eecp=zz >> OUT\T7USAGE.TXT
W9XFIX -x show >> OUT\T7USAGE.TXT
W9XFIX -l C:\NOSUCH\DIR\X.TXT show >> OUT\T7USAGE.TXT
